# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Needed to create member accounts, reset passwords, and record
# cleaning for members. Never commit it and never expose it to the browser.
SUPABASE_SECRET_KEY=

# Public URL of the deployed app (used in password-reset emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
